{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": {"1":"magenta", "2": "magenta"}
    },
    "display": {
        "size": {
            "maxPrefix": "MB"
        },
        "separator": " → ",
        "color":  {
            "title": "magenta",
            "keys": "white",
            "separator": "magenta",
            "output": "white"
        }
    },
    "modules": [
        "break",
        "break",
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS    "
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Pkgs  "
        },
        {
            "type": "shell",
            "key": "Shell "
        },
        {
            "type": "de",
            "key": "DE    "
        },
        {
            "type": "wm",
            "key": "WM    "
        },
        {
            "type": "display",
            "key": "Mon   ",
            "compactType": "none",     // prints each display on its own line
            "preciseRefreshRate": false,
            "format": "{width}x{height} @ {refresh-rate}Hz ({name})"
        },
        {
            "type": "CPU",
            "key": "CPU   ",
            "format": "{1} ({5}) @ {6}"
        },
        {
            "type": "GPU",
            "key": "GPU   "
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "battery",
            "key": "Battery"
        },
        {
            "type": "poweradapter",
            "key": "AC     "
        },
        {
            "type": "media",
            "key": "Media "
        },
        "break"
    ]
}
